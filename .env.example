KOMMO_SUBDOMAIN=                  # p.ej. miempresa  (de https://miempresa.kommo.com)
KOMMO_LONG_LIVED_TOKEN=           # token de larga duracion de la integracion privada
KOMMO_PIPELINE_ID=                # embudo destino (lo resolvemos por API)

# --- Leads de Meta (hoja de Google de marketing) ---
