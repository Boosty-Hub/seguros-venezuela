# ============================================================================
# Variables de entorno para la sincronizacion (copiar a sync/.env para local)
# En produccion se configuran como GitHub Actions secrets.
# ============================================================================

# --- Zoho Desk ---
ZOHO_CLIENT_ID=
ZOHO_CLIENT_SECRET=
ZOHO_REFRESH_TOKEN=
ZOHO_ORG_ID=850320350
ZOHO_DEPARTMENT_ID=977937000034750449
ZOHO_ACCOUNTS_HOST=https://accounts.zoho.com
ZOHO_DESK_HOST=https://desk.zoho.com

# --- Supabase ---
SUPABASE_URL=https://lwqqnnefywsjaatuyjma.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_TOKEN_PERSONAL=          # personal access token (sbp_...), solo para la Management API

# --- Kommo CRM ---
# Integracion privada: Kommo -> Ajustes -> Integraciones -> Crear integracion.
KOMMO_SUBDOMAIN=                  # p.ej. miempresa  (de https://miempresa.kommo.com)
KOMMO_LONG_LIVED_TOKEN=           # token de larga duracion de la integracion privada
KOMMO_PIPELINE_ID=                # embudo destino (lo resolvemos por API)

# --- Leads de Meta (hoja de Google de marketing) ---
# La hoja hoy es accesible por enlace, asi que no hace falta credencial.
# Si se cierra el acceso publico, apuntar META_SHEET_CSV_URL a un endpoint
# autenticado (cuenta de servicio) y el resto del codigo no cambia.
META_SHEET_ID=1jUy4z0CPGV3DkF28goP8rqxL9qUZSJPMh3H6MwwPhiE
META_SHEET_CSV_URL=               # opcional: sobrescribe la URL de descarga

# ============================================================================
# Agente de IA (Kommo -> Claude -> Kommo), en web/ + supabase/functions
# ============================================================================
# El dashboard Next.js (web/) tiene su PROPIO .env.example en web/.env.example
# (copiar a web/.env.local para desarrollo local). Las credenciales de
# Anthropic/Kommo para el agente NO van en .env: se cargan desde el wizard
# /setup del dashboard y quedan en la tabla runtime_config (DB-first).
#
# Unico secreto de infraestructura que sí vive fuera de la DB:
KOMMO_WEBHOOK_SECRET=             # valida que el POST a kommo-webhook venga de Kommo